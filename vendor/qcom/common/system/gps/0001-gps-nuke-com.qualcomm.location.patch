From d2fa592234cea7c4fec2a370301391bbd306dced Mon Sep 17 00:00:00 2001
From: PugzAreCute <me@pugzarecute.com>
Date: Fri, 12 Apr 2024 22:14:34 +0530
Subject: [PATCH] gps: nuke com.qualcomm.location

* Spams logcat requesting for ILocAidlGNSS, ILocHidlGNSS@4.(1,2), which
  we dont have.
---
 system/gps/Android.bp                         |  12 ------
 system/gps/gps-vendor.mk                      |   3 --
 .../etc/permissions/com.qualcomm.location.xml |  24 ------------
 ...vapp-permissions-com.qualcomm.location.xml |  35 ------------------
 .../com.qualcomm.location.apk                 | Bin 3600166 -> 0 bytes
 5 files changed, 74 deletions(-)
 delete mode 100644 system/gps/proprietary/system_ext/etc/permissions/com.qualcomm.location.xml
 delete mode 100644 system/gps/proprietary/system_ext/etc/permissions/privapp-permissions-com.qualcomm.location.xml
 delete mode 100644 system/gps/proprietary/system_ext/priv-app/com.qualcomm.location/com.qualcomm.location.apk

diff --git a/system/gps/Android.bp b/system/gps/Android.bp
index 1c950a0..9f962f3 100644
--- a/system/gps/Android.bp
+++ b/system/gps/Android.bp
@@ -5,18 +5,6 @@
 soong_namespace {
 }
 
-android_app_import {
-	name: "com.qualcomm.location",
-	owner: "qcom/common",
-	apk: "proprietary/system_ext/priv-app/com.qualcomm.location/com.qualcomm.location.apk",
-	certificate: "platform",
-	dex_preopt: {
-		enabled: false,
-	},
-	privileged: true,
-	system_ext_specific: true,
-}
-
 dex_import {
 	name: "com.qti.location.sdk",
 	owner: "qcom/common",
diff --git a/system/gps/gps-vendor.mk b/system/gps/gps-vendor.mk
